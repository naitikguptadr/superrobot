def dr_litellm_completion(*args: Any, **kwargs: Any) -> Any:
    import litellm

    cfg = _gateway_config()
    if cfg:
        kwargs.setdefault("api_base", cfg["base_url"])
        kwargs.setdefault("api_key", cfg["api_key"])
        if "model" in kwargs:
            kwargs["model"] = _gateway_model(kwargs["model"])
    return litellm.completion(*args, **kwargs)
