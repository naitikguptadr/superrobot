"""DataRobot LLM Gateway routing — generated by SuperRobot.

When DR credentials are present (always true on a DataRobot deployment, where
DATAROBOT_ENDPOINT and DATAROBOT_API_TOKEN are injected automatically), every
LLM client in the migrated code is rewired to the DR LLM Gateway — no provider
API keys needed. Without DR credentials the original provider config is used
unchanged, so the agent still runs locally exactly as before.
"""

from __future__ import annotations

import os
from typing import Any

DEFAULT_GATEWAY_MODEL = "{{ default_model }}"


def _gateway_config() -> dict[str, str]:
    endpoint = os.environ.get("DATAROBOT_ENDPOINT", "").strip().rstrip("/")
    if endpoint.endswith("/api/v2"):
        endpoint = endpoint[: -len("/api/v2")]
    token = os.environ.get("DATAROBOT_API_TOKEN", "").strip()
    if not endpoint or not token:
        return {}
    return {"base_url": f"{endpoint}/api/v2/genai/llmgw", "api_key": token}


def _gateway_model(model: Any) -> str:
    """Provider-prefixed models pass through; bare ones map to the DR default."""
    if model and "/" in str(model):
        return str(model)
    return os.environ.get("SUPERROBOT_MODEL", DEFAULT_GATEWAY_MODEL)


def dr_chat_openai(*args: Any, **kwargs: Any) -> Any:
    """langchain ChatOpenAI, routed through the DR LLM Gateway on DR."""
    from langchain_openai import ChatOpenAI

    cfg = _gateway_config()
    if cfg:
        kwargs.pop("api_key", None)
        kwargs.pop("base_url", None)
        kwargs.pop("openai_api_key", None)
        kwargs.pop("openai_api_base", None)
        kwargs["model"] = _gateway_model(kwargs.get("model") or kwargs.get("model_name"))
        kwargs.pop("model_name", None)
        kwargs.update(cfg)
    return ChatOpenAI(*args, **kwargs)


def dr_azure_chat_openai(*args: Any, **kwargs: Any) -> Any:
    """AzureChatOpenAI call sites — on DR the gateway already fronts Azure."""
    cfg = _gateway_config()
    if cfg:
        for key in (
            "api_key",
            "azure_endpoint",
            "azure_deployment",
            "api_version",
            "openai_api_key",
        ):
            kwargs.pop(key, None)
        kwargs["model"] = _gateway_model(kwargs.get("model"))
        return dr_chat_openai(*args, **kwargs)
    from langchain_openai import AzureChatOpenAI

    return AzureChatOpenAI(*args, **kwargs)


def dr_openai(*args: Any, **kwargs: Any) -> Any:
    """openai.OpenAI client, pointed at the DR LLM Gateway on DR.

    Note: pass provider-prefixed model names (e.g. azure/gpt-...) in your
    completion calls when running on DR.
    """
    from openai import OpenAI

    cfg = _gateway_config()
    if cfg:
        kwargs.pop("api_key", None)
        kwargs.pop("base_url", None)
        kwargs.update(cfg)
    return OpenAI(*args, **kwargs)


def dr_async_openai(*args: Any, **kwargs: Any) -> Any:
    """openai.AsyncOpenAI client, pointed at the DR LLM Gateway on DR."""
    from openai import AsyncOpenAI

    cfg = _gateway_config()
    if cfg:
        kwargs.pop("api_key", None)
        kwargs.pop("base_url", None)
        kwargs.update(cfg)
    return AsyncOpenAI(*args, **kwargs)
