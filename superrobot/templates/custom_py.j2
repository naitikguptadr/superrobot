import os
from typing import Any

_RUNTIME_PARAM_KEYS = [
{% for key in runtime_param_keys %}
    "{{ key }}",
{% endfor %}
]


def load_runtime_params() -> dict[str, str]:
    """Load runtime parameters from environment."""
    return {key: os.environ[key] for key in _RUNTIME_PARAM_KEYS if key in os.environ}


async def run(payload: dict[str, Any]) -> dict[str, Any]:
    """Agent entry point called by DataRobot."""
    from myagent import MyAgent

    params = load_runtime_params()
    agent = MyAgent(runtime_params=params)
    return await agent.process(payload)
