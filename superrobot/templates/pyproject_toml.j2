[project]
name = "{{ agent_name }}"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
{% for dep in dependencies %}
    "{{ dep }}",
{% endfor %}
]

# Dependency manifest for the DR agent bundle — not an installable package.
# `uv sync` here creates a venv with the agent's dependencies for local eval.
[tool.uv]
package = false
