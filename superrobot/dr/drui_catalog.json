{
  "components": [
    {
      "name": "Button",
      "import": "@dr-ui/button",
      "props": ["variant", "size", "onClick", "children"],
      "example": "<Button variant=\"primary\" onClick={handleSubmit}>Run</Button>"
    },
    {
      "name": "TextInput",
      "import": "@dr-ui/text-input",
      "props": ["label", "value", "onChange", "placeholder"],
      "example": "<TextInput label=\"Query\" value={query} onChange={setQuery} />"
    },
    {
      "name": "Card",
      "import": "@dr-ui/card",
      "props": ["title", "children"],
      "example": "<Card title=\"Results\">{children}</Card>"
    },
    {
      "name": "DataTable",
      "import": "@dr-ui/data-table",
      "props": ["columns", "data"],
      "example": "<DataTable columns={cols} data={rows} />"
    },
    {
      "name": "Badge",
      "import": "@dr-ui/badge",
      "props": ["variant", "children"],
      "example": "<Badge variant=\"success\">Pass</Badge>"
    }
  ]
}
