{
  "name": "superrobot-shell",
  "version": "0.4.0",
  "description": "Premium DataRobot-native SuperRobot interactive shell (Pi customization)",
  "type": "module",
  "bin": {
    "superrobot-ui": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p extensions/tsconfig.json",
    "test": "node --test extensions/superrobot/*.test.ts"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@mariozechner/pi-tui": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
